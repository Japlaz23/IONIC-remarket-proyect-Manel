{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "../frontend-refactor/src/views/Chat.vue", "../frontend-refactor/src/views/ChatConversation.vue", "../frontend-refactor/src/views/Favorites.vue", "../frontend-refactor/src/views/Login.vue", "../frontend-refactor/src/views/PaymentCheck.vue", "../frontend-refactor/src/views/ProductDetail.vue", "../frontend-refactor/src/views/ProfielSeller.vue", "../frontend-refactor/src/views/ProfileCostumer.vue", "../frontend-refactor/src/views/Purchases.vue", "../frontend-refactor/src/views/Register.vue", "../frontend-refactor/src/views/RestorePassword.vue", "../frontend-refactor/src/views/Sales.vue", "../frontend-refactor/src/views/Search.vue", "../frontend-refactor/src/views/Sell.vue", "../frontend-refactor/src/views/Settings.vue", "../frontend-refactor/src/views/Tabs.vue", "../frontend-refactor/src/views/Home.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
